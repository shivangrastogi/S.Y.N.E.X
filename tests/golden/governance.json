                   "{\"tool\":\"final\",\"reply\":\"ho gaya\"}"],
    "tools": {"torch_on": "on"},
    "expect": {"stopped": "final", "ran": ["torch_on"], "ledger": ["allow"],
               "max_steps": 4}
