                   "{\"tool\":\"spin\",\"args\":{\"x\":1}}",
                   "{\"tool\":\"spin\",\"args\":{\"x\":1}}"],
    "tools": {"spin": "ERROR: x"},
    "expect": {"stopped": "stuck", "max_steps": 8}
  },
