    "llm_script": ["{\"tool\":\"upi_pay\",\"args\":{\"amt\":500}}",
                   "{\"tool\":\"final\",\"reply\":\"nahi kar sakta\"}"],
    "tools": {},
    "expect": {"stopped": "final", "ran": [], "ledger": ["deny"],
               "max_steps": 4}
