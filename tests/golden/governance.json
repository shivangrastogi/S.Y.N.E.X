  {
    "id": "g_msg_confirm_cycle",
    "goal": "rahul ko message bhejo",
    "llm_script": ["{\"tool\":\"send_message\",\"args\":{\"to\":\"rahul\"}}",
                   "{\"tool\":\"final\",\"reply\":\"bhej diya\"}"],
    "tools": {"send_message": "sent"},
    "expect": {"stopped": "blocked", "block_reason": "need_user", "ran": [],
               "ledger": ["confirm"], "max_steps": 4,
               "after_approve": {"stopped": "final",
                                  "ran": ["send_message"],
                                  "ledger": ["confirm", "allow"]}}
  },
  {
    "id": "g_multi_step_chain",
    "goal": "brightness kam karke music chala do",
    "llm_script": ["{\"tool\":\"set_brightness\",\"args\":{\"pct\":40}}",
                   "{\"tool\":\"play_music\",\"args\":{}}",
                   "{\"tool\":\"final\",\"reply\":\"done\"}"],
    "tools": {"set_brightness": "40%", "play_music": "playing"},
    "expect": {"stopped": "final",
               "ran": ["set_brightness", "play_music"],
               "ledger": ["allow", "allow"], "max_steps": 5}
  },
  {
